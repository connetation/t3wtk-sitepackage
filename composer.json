{
    "name": "connetation/t3wtk-sitepackage",
    "version": "3.0.0",
    "description": "Connetation Sitepackage – site-specific extension built on connetation/t3wtk-base for TYPO3 LTS 14",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Connetation Web Engineering GmbH",
            "email": "office@connetation.at",
            "homepage": "https://www.connetation.at/"
        }
    ],
    "require": {
        "typo3/cms-core": "^14.0",
        "baschte/content-animations": "^2.7",
        "connetation/t3wtk-base": "^3.0.0",
        "connetation/t3wtk-elements": "^3.0.0",
        "clickstorm/cs-seo": "^10.2"
    },
    "replace": {
        "conn/t3kit-sitepackage": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Connetation\\T3wtkSitepackage\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "conn_t3wtk_sitepackage"
        }
    },
    "suggest": {
        "georgringer/news": "Enables the cs_seo integration in Configuration/CsSeo/news.yaml",
        "derhansen/sf_event_mgt": "Enables the cs_seo integration in Configuration/CsSeo/events.yaml"
    }
}
